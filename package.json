{
  "name": "deadforge",
  "version": "v2.0.0-Beta-4",
  "description": "An Electron Launcher for DeadCode Projects (AND OTHER STUFF TOO NOW :3).",
  "author": "DeadCodeGames <404@mail.deadcode.is-a.dev> (https://deadcode.is-a.dev)",
  "contributors": [
    "Richard Kanshen <kanshen@mail.deadcode.is-a.dev> (https://kanshen.click)",
    "QlexcTheFox <80660200+musiconstereo@users.noreply.github.com> (https://github.com/MusicOnStereo)"
  ],
  "license": "BSD-3-Clause",
  "repository": "github:DeadCodeGames/DeadForge",
  "private": true,
  "engineStrict": true,
  "engines": {
    "node": "^22.14.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "axios": "^1.14.0",
    "better-sqlite3": "^11.9.1",
    "chokidar": "^4.0.3",
    "electron-window-state": "^5.0.3",
    "json-stream-stringify": "^3.1.6",
    "ps-list": "^8.1.1",
    "registry-js": "github:DeadCodeGames/registry-js",
    "vdf": "^0.0.2"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@babel/register": "^7.25.9",
    "@dead404code/tailwind-remove-base-border-box": "^1.0.0-Patch",
    "@dead404code/tailwind-utilities": "^1.0.1-Patch",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.26.0",
    "@icons-pack/react-simple-icons": "^12.7.0",
    "@lucide/lab": "^0.1.2",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/eslint-plugin-jsx-a11y": "^6.10.0",
    "@types/flat": "^5.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "@types/react-router-dom": "^5.3.3",
    "@types/react-twemoji": "^0.4.3",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cpx": "^1.5.0",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "electron": "^35.1.5",
    "electron-builder": "^26.8.1",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^9.26.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "flat": "^6.0.1",
    "globals": "^16.1.0",
    "html-minifier-terser": "^7.2.0",
    "i18next": "^25.0.0",
    "install": "^0.13.0",
    "lucide-react": "^0.487.0",
    "navigation-api-types": "^0.6.1",
    "nodemon": "^3.1.9",
    "npm": "^11.12.1",
    "react": "^19.1.0",
    "react-app-rewired": "^2.2.1",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.4.1",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.14.0",
    "react-scripts": "5.0.1",
    "react-twemoji": "^0.6.0",
    "tailwind-merge": "^3.2.0",
    "tsx": "^4.19.3",
    "twemoji": "^14.0.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "wait-on": "^8.0.3"
  },
  "main": "./electron-dist/main.js",
  "homepage": "./",
  "build": {
    "appId": "dev.deadcode.forge",
    "extends": null,
    "productName": "DeadForge",
    "compression": "maximum",
    "directories": {
      "buildResources": "buildResources"
    },
    "files": [
      "build/**/*",
      "electron-dist/**/*",
      "package.json",
      "!node_modules/*/{test,__tests__,tests}/**",
      "!**/*.map",
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "resources/bin/VDFParser/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "dev.deadcode.forge-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeadForge",
      "include": "buildResources/install-dotnet.nsh"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "dev.deadcode.forge-${version}.${ext}"
    },
    "linux": {
      "target": "deb",
      "artifactName": "dev.deadcode.forge-${version}.${ext}"
    }
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{js,mjs,cjs,ts,jsx,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,mjs,cjs,ts,jsx,tsx}\" --fix",
    "postinstall": "electron-rebuild -f -w better-sqlite3,registry-js",
    "start": "npm run electron:serve",
    "react:start": "react-app-rewired start",
    "prereact:start": "cpx \"customTwemoji/*.svg\" \"public/twemoji/svg\"",
    "prereact:build": "node scripts/fetchTwemoji.js",
    "react:build": "react-app-rewired build",
    "postreact:build": "tsx scripts/hydrateLoader.js",
    "react:test": "react-app-rewired test",
    "react:eject": "react-scripts eject",
    "electron:serve": "concurrently -k \"cross-env BROWSER=none npm run react:start\" \"wait-on tcp:3000 && npm run electron:dev\"",
    "electron:dev": "node electron/dev.js",
    "electron:build": "tsc -p electron/electron.tsconfig.json && cpx \"electron/**/*.{png,jpg}\" electron-dist -C",
    "full-build": "concurrently --kill-others-on-fail \"npm run react:build\" \"npm run electron:build\"",
    "electron:package": "npm run full-build && electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
