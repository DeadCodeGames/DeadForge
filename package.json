{
  "name": "deadforge",
  "version": "v2.0.0-Dev",
  "description": "An Electron Launcher for DeadCode Projects (AND OTHER STUFF TOO NOW :3).",
  "author": "DeadCodeGames <404@mail.deadcode.is-a.dev> (https://deadcode.is-a.dev)",
  "contributors": [
    "Richard Kanshen <kanshen@mail.deadcode.is-a.dev> (https://kanshen.click)",
    "QlexcTheFox <80660200+musiconstereo@users.noreply.github.com> (https://github.com/MusicOnStereo)"
  ],
  "license": "BSD-3-Clause",
  "repository": "github:DeadCodeGames/DeadForge",
  "private": true,
  "dependencies": {
    "@dead404code/tailwind-remove-base-border-box": "^1.0.0-Patch",
    "@dead404code/tailwind-utilities": "^1.0.1-Patch",
    "@electron/remote": "^2.1.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "@types/react-router-dom": "^5.3.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-window-state": "^5.0.3",
    "react": "^19.1.0",
    "react-app-rewired": "^2.2.1",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@babel/register": "^7.25.9",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "html-minifier-terser": "^7.2.0",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  },
  "main": "./electron-dist/main.js",
  "homepage": "./",
  "build": {
    "appId": "dev.deadcode.forge",
    "extends": null,
    "productName": "DeadForge",
    "files": [
      "build/**/*",
      "electron-dist/**/*",
      "package.json",
      "!node_modules/*/{test,__tests__,tests}/**",
      "!**/*.map"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "artifactName": "dev.deadcode.forge-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "dev.deadcode.forge-${version}.${ext}"
    },
    "linux": {
      "target": "deb",
      "artifactName": "dev.deadcode.forge-${version}.${ext}"
    }
  },
  "scripts": {
    "react:start": "react-app-rewired start",
    "react:build": "react-app-rewired build",
    "react:test": "react-app-rewired test",
    "react:eject": "react-scripts eject",
    "electron:serve": "concurrently -k \"cross-env BROWSER=none npm run react:start\" \"npm run electron:start\"",
    "electron:start": "npm run electron:build && wait-on tcp:3000 & electron .",
    "electron:build": "tsc -p electron/electron.tsconfig.json",
    "full-build": "npm run react:build && npm run electron:build",
    "electron:package": "npm run full-build && electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}