{
    "compilerOptions": {
      "target": "ES2020",
      "module": "CommonJS",
      "outDir": "../dist",
      "rootDir": "./",
      "strict": true,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "noEmitOnError": true,
      "allowJs": false,
      "types": ["electron"]
    },
    "include": ["main.ts", "preload.ts"]
  }
  